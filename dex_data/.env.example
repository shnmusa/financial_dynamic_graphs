# ---------------------------------------------------------------------------
# Ethereum RPC
# ---------------------------------------------------------------------------
# Comma separated. The client round-robins across them and fails over on error,
# so listing several free public endpoints materially raises effective throughput.
#
# Free public (no key, no archive state):
#DEX_RPC_URLS=https://eth.llamarpc.com,https://ethereum-rpc.publicnode.com,https://eth.drpc.org
#
# Recommended once you need historical balanceOf / getReserves / slot0
# (top-10 holders and pool liquidity over time). Alchemy's free tier includes
# archive access; drop the key in and use this line instead:
DEX_RPC_URLS=https://eth-mainnet.g.alchemy.com/v2/ALCHEMY_API_KEY

# Set true only if your endpoints serve archive state. Enables historical eth_call.
DEX_ARCHIVE=false

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
DEX_PG_DSN=postgresql://dex:dex@localhost:5433/dex_data

# ---------------------------------------------------------------------------
# Ingest window and parallelism
# ---------------------------------------------------------------------------
DEX_DAYS=30
DEX_MAX_WORKERS=4
# Starting block span per eth_getLogs call. Halved automatically when a provider
# rejects the response as too large, so this is a hint, not a hard limit.
DEX_LOG_CHUNK_BLOCKS=20
DEX_RPC_TIMEOUT=60
DEX_RPC_MAX_RETRIES=8
# Per-endpoint request rate cap (requests/second). Keeps free endpoints from 429ing.
DEX_RPC_RATE_LIMIT=8
